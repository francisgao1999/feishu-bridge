# 飞书应用
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 允许使用的 open_id，逗号分隔；留空表示不限制。
# 多用户模式下建议留空，由 config/users.json 决定谁能用。
FEISHU_ALLOWED_OPEN_IDS=

# 未开通用户尝试使用时通知的管理员（逗号分隔 open_id）
BRIDGE_ADMIN_OPEN_IDS=
# 同一未开通用户的通知冷却时间（秒）
BRIDGE_UNKNOWN_USER_COOLDOWN_SECONDS=3600

# 用户映射文件（容器内路径；compose 挂载 ./config:/app/config:ro）
BRIDGE_USERS_FILE=/app/config/users.json

# 沙箱模式：container/sandbox/lxc 时默认放行，仅破坏性命令（rm -rf、git push、
# 容器删除等）仍发审批卡片
BRIDGE_SANDBOX_MODE=container

# OpenCode API（单用户兼容模式；多用户模式由 users.json 决定）
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=
# 默认: $BRIDGE_HOME/../workspace（与仓库同级，即 ~/workspace）
# OPENCODE_DIRECTORY=/path/to/workspace
# 新会话的默认 Agent；运行时可用 /agent 切换
OPENCODE_AGENT=build
# 切换时按只读处理、不注入 edit ask 会话规则的 Agent（逗号分隔）
OPENCODE_READONLY_AGENTS=plan
OPENCODE_MODEL_PROVIDER=opencode
OPENCODE_MODEL_ID=big-pickle

# 桥接器目录与数据
# BRIDGE_HOME 默认是仓库根目录，一般不需要设置。
# BRIDGE_HOME=/app
# BRIDGE_DATA_DIR 默认等于 BRIDGE_HOME。
# BRIDGE_DATA_DIR=/app/data
# 默认: $BRIDGE_DATA_DIR/bridge.db
# BRIDGE_DB=/path/to/bridge.db
# 默认: $BRIDGE_DATA_DIR/bridge.log
# BRIDGE_LOG=/path/to/bridge.log

# 文件上传（入站）
# 上传临时目录（下载落盘 + 出站中转）
BRIDGE_UPLOAD_TMP_DIR=/app/data/uploads
# 入站上限：飞书「获取消息中的资源文件」硬限制 100MB，调大没有意义
BRIDGE_MAX_UPLOAD_BYTES=104857600
# 用户工作区内的入站子目录
BRIDGE_UPLOAD_SUBDIR=uploads
# 用户工作区内的出站子目录
BRIDGE_OUTBOX_SUBDIR=outbox
# 出站扫描间隔（秒）
BRIDGE_OUTBOX_SCAN_SECONDS=60
# 出站图片上限（飞书 im/v1/images 限制 10MB）
BRIDGE_MAX_OUTBOX_IMAGE_BYTES=10485760
# 出站文件上限（飞书 im/v1/files 限制 30MB）
BRIDGE_MAX_OUTBOX_FILE_BYTES=31457280

# 进度与审批
# 进度卡片实时刷新间隔（秒）。事件只更新内存状态，卡片按此间隔节流重绘；
# 每次任务结束会强制刷新一次，保证最终状态一定落到卡片上。
BRIDGE_PROGRESS_MIN_INTERVAL=5
BRIDGE_PERMISSION_REMIND_SECONDS=600
BRIDGE_PERMISSION_EXPIRE_SECONDS=1800

# 提问（form）交互
# 超过提醒时间后发一次文字提醒；超过过期时间后自动取消并中断任务。
# 设为 0 可关闭提醒或自动过期。
BRIDGE_FORM_REMIND_SECONDS=300
BRIDGE_FORM_EXPIRE_SECONDS=1800

# 任务对账与超时
BRIDGE_TASK_RECONCILE_SECONDS=60
BRIDGE_TASK_RECONCILE_GRACE_SECONDS=120
# 大 SQL 导入可能超过 1 小时，默认 2 小时
BRIDGE_TASK_TIMEOUT_SECONDS=7200

# 结果截断
BRIDGE_MAX_FINAL_CHARS=3000
BRIDGE_MAX_TEXT_CHUNK=3000

# 遗留配置：临时会话已移除，以下变量保留但不再使用
# BRIDGE_TEMP_SESSION_TTL_SECONDS=1800
# BRIDGE_TEMP_WORKSPACE_ROOT=/path/to/temp
