# 飞书应用
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 允许使用的 open_id，逗号分隔
FEISHU_ALLOWED_OPEN_IDS=

# OpenCode API
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=
# 默认: $BRIDGE_HOME/workspace
# OPENCODE_DIRECTORY=/path/to/workspace
OPENCODE_AGENT=build
OPENCODE_MODEL_PROVIDER=opencode
OPENCODE_MODEL_ID=big-pickle

# 桥接器目录与数据
# BRIDGE_HOME 默认是仓库根目录，一般不需要设置。
# BRIDGE_HOME=/home/oc/feishu-opencode-bridge
# BRIDGE_DATA_DIR 默认等于 BRIDGE_HOME。
# BRIDGE_DATA_DIR=/var/lib/feishu-bridge
# 默认: $BRIDGE_DATA_DIR/bridge.db
# BRIDGE_DB=/path/to/bridge.db
# 默认: $BRIDGE_DATA_DIR/bridge.log
# BRIDGE_LOG=/path/to/bridge.log

# 进度与审批
BRIDGE_PROGRESS_MIN_INTERVAL=20
BRIDGE_PERMISSION_REMIND_SECONDS=600
BRIDGE_PERMISSION_EXPIRE_SECONDS=1800

# 任务对账与超时
BRIDGE_TASK_RECONCILE_SECONDS=60
BRIDGE_TASK_RECONCILE_GRACE_SECONDS=120
BRIDGE_TASK_TIMEOUT_SECONDS=3600

# 结果截断
BRIDGE_MAX_FINAL_CHARS=3000
BRIDGE_MAX_TEXT_CHUNK=3000

# 临时会话
BRIDGE_TEMP_SESSION_TTL_SECONDS=1800
# 默认: $BRIDGE_DATA_DIR/temp
# BRIDGE_TEMP_WORKSPACE_ROOT=/path/to/temp
