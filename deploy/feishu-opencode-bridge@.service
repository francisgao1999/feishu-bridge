[Unit]
Description=Feishu <-> OpenCode bridge (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=~
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash -c 'exec "$HOME/feishu-opencode-bridge/.venv/bin/python" "$HOME/feishu-opencode-bridge/app/main.py"'
Restart=always
RestartSec=5
MemoryMax=384M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
