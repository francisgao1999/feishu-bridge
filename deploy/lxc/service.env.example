# 用户 LXC 内的服务环境变量（随模板克隆到每个用户 LXC）。
# 安装位置：/etc/opencode/service.env，权限 600。
# opencode-serve.service 会通过 EnvironmentFile 加载本文件。
# 这里的密钥必须与管理员本机 OpenCode 使用的同名密钥一致。

# 模型服务商
SYSTALYZE_API_KEY=

# 远程 MCP：Context7
CONTEXT7_API_KEY=

# 远程 MCP：Exa
EXA_API_KEY=

# Playwright 浏览器缓存：模板把 Chromium 装在 /root/.cache/ms-playwright。
# opencode-serve 设置了 XDG_CACHE_HOME=/var/cache/opencode；若不显式指定，
# Playwright 会去 /var/cache/opencode/ms-playwright 找，误判“未安装”并重复下载约 700MB。
PLAYWRIGHT_BROWSERS_PATH=/root/.cache/ms-playwright
